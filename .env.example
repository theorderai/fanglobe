# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Upstash Redis (live vote counts, tap timeseries, rate limits) ─────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Anthropic (vent moderation only) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.fanglobe.live
CRON_SECRET=long-random-string
# Ref Desk (/admin). At least 16 characters.
ADMIN_SECRET=another-long-random-string

# ── Optional: API-Football live feed (paid plan needed for per-minute polling) ─
API_FOOTBALL_KEY=
# Comma-separated league ids. 39 = Premier League, 2 = Champions League, 140 = La Liga
FEED_LEAGUES=39
FEED_SEASON=2026
